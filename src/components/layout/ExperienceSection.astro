---
// src/components/layout/ExperienceSection.astro

const experiences = [
  {
    role: "Independent Software Engineer",
    company: "Independent Maker",
    date: "August 2026 to Present",
    description: "Building web applications and tools from scratch. Handling system design, backend APIs, database architecture, and frontend deployment.",
    projects: [
      "Building standalone web products using modern TypeScript and Node.js ecosystems.",
      "Creating fast, search optimized web pages with automated deployment pipelines."
    ]
  },
  {
    role: "Full Stack Engineer",
    company: "Widya Robotics",
    date: "October 2025 to August 2026",
    description: "Built full stack web applications for AI powered industrial monitoring and healthcare products. Containerized and operated multiservice stacks in production.",
    projects: [
      "AI Quality Control System: Designed a microservices system using TimescaleDB and Redis Streams for high throughput event processing.",
      "AI Smart Factory Counting System: Developed a production backend with NestJS, MQTT for IoT integration, and Next.js frontend with live streaming.",
      "AI Clinic Chatbot and RAG: Built an application around a retrieval engine using FastAPI, Next.js, and PostgreSQL with pgvector.",
      "AI Conveyor Sack Counting System: Rebuilt a legacy system into a modular multiservice architecture using Next.js and PostgreSQL."
    ]
  }
];
---

<section id="experience" class="w-full max-w-7xl mx-auto px-6 py-24 border-l border-r border-b border-workbench-border">
  <div class="flex items-center gap-4 mb-12">
    <div class="h-px w-8 bg-workbench-accent"></div>
    <span class="font-mono text-xs tracking-widest text-workbench-accent uppercase">
      // 02. Experience Log
    </span>
  </div>

  <div class="flex flex-col gap-12">
    {experiences.map((exp) => (
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        <!-- Date / Meta -->
        <div class="md:col-span-3 pt-1">
          <span class="font-mono text-sm text-workbench-muted">{exp.date}</span>
        </div>
        
        <!-- Content -->
        <div class="md:col-span-9 flex flex-col">
          <h3 class="text-2xl font-display font-bold text-workbench-text mb-1">{exp.role}</h3>
          <span class="text-lg font-display text-workbench-accent mb-4">{exp.company}</span>
          
          <p class="text-workbench-muted font-body mb-6 leading-relaxed">
            {exp.description}
          </p>
          
          <ul class="flex flex-col gap-4">
            {exp.projects.map(project => (
              <li class="flex items-start gap-3">
                <div class="mt-2 w-1.5 h-1.5 rounded-none bg-workbench-border shrink-0"></div>
                <span class="text-workbench-muted font-body leading-relaxed">{project}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
