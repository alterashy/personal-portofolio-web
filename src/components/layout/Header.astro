---
// src/components/layout/Header.astro

const navLinks = [
  { label: 'About', href: '/#about' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Products', href: '/products' }
];
---

<header class="fixed top-0 left-0 w-full z-50 bg-workbench-bg border-b border-workbench-border h-16">
  <div class="max-w-7xl mx-auto px-6 h-full flex items-center justify-between border-l border-r border-workbench-border">
    
    <!-- Logo / Identity -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-3 h-3 bg-workbench-accent group-hover:scale-110 transition-transform"></div>
      <span class="font-display font-bold text-lg tracking-tight text-workbench-text uppercase">
        Syifa.M
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center h-full">
      <ul class="flex items-center h-full">
        {navLinks.map((link) => (
          <li class="h-full border-l border-workbench-border last:border-r">
            <a 
              href={link.href} 
              class="h-full flex items-center px-6 font-mono text-xs uppercase tracking-widest text-workbench-muted hover:text-workbench-accent hover:bg-workbench-surface transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile Navigation Toggle -->
    <button id="mobile-menu-btn" class="md:hidden p-2 text-workbench-text border border-workbench-border flex items-center justify-center hover:bg-workbench-surface transition-colors">
      <span class="font-mono text-xs uppercase tracking-widest">Menu</span>
    </button>
    
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden absolute top-16 left-0 w-full bg-workbench-bg border-b border-workbench-border flex-col shadow-2xl">
    <nav class="flex flex-col w-full max-w-7xl mx-auto px-6 border-l border-r border-workbench-border">
      <ul class="flex flex-col w-full">
        {navLinks.map((link) => (
          <li class="w-full border-b border-workbench-border last:border-b-0">
            <a 
              href={link.href} 
              class="mobile-link block w-full py-4 px-4 font-mono text-sm uppercase tracking-widest text-workbench-muted hover:text-workbench-accent hover:bg-workbench-surface transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Simple client-side script for mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
    });

    // Close menu when a link is clicked
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
      });
    });
  }
</script>
