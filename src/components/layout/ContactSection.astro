---
// src/components/layout/ContactSection.astro
---
<section id="contact" class="w-full max-w-7xl mx-auto px-6 py-24 border-l border-r border-workbench-border">
  <div class="flex flex-col items-center text-center max-w-3xl mx-auto py-16">
    <div class="flex items-center gap-4 mb-8">
      <div class="h-px w-8 bg-workbench-accent"></div>
      <span class="font-mono text-xs tracking-widest text-workbench-accent uppercase">
        // 05. Next Steps
      </span>
      <div class="h-px w-8 bg-workbench-accent"></div>
    </div>
    
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-workbench-text leading-tight mb-6">
      Let's build something together.
    </h2>
    
    <p class="text-lg text-workbench-muted font-body leading-relaxed mb-10">
      Whether you have a specific project in mind or just want to chat about system architecture, my inbox is open. I'll try my best to get back to you!
    </p>
    
    <a 
      href="mailto:maulayasyifa.mail@gmail.com"
      class="px-8 py-4 bg-transparent text-workbench-text font-display font-bold text-lg tracking-wide uppercase border border-workbench-accent hover:bg-workbench-accent hover:text-white transition-colors duration-200"
    >
      Hire Me
    </a>
  </div>
</section>
