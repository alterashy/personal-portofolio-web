---
// src/components/layout/ProjectsSection.astro
import TechIcon from '../ui/TechIcon.astro';

const projects = [
  {
    id: "PRJ_01",
    name: "Circle",
    tagline: "Threads-like Social Platform",
    description: "Full-featured social media platform with real-time posting, threaded replies, likes, follow graph, JWT authentication, and infinite scroll pagination with 95+ Lighthouse score.",
    highlight: "95+ Lighthouse",
    stack: ["React", "Express.js", "PostgreSQL", "Prisma ORM"],
    link: "https://github.com/alterashy"
  },
  {
    id: "PRJ_02",
    name: "BookUs",
    tagline: "Bus Ticket Booking Engine",
    description: "Dual-interface platform for passengers and administrators featuring guest checkout, seat reservation flow, and secure Midtrans payment integration via Supabase Edge Functions.",
    highlight: "Midtrans Snap API",
    stack: ["React", "Supabase", "Midtrans API"],
    link: "https://github.com/alterashy"
  },
  {
    id: "PRJ_03",
    name: "MieVerse",
    tagline: "Instant Noodle Catalog & Review",
    description: "Multi-criteria food rating and review platform with advanced faceted search, full SSR metadata rendering, and 98+ Lighthouse SEO score.",
    highlight: "98+ SEO Score",
    stack: ["Next.js", "PostgreSQL", "SSR"],
    link: "https://github.com/alterashy"
  }
];
---

<section id="projects" class="w-full max-w-7xl mx-auto px-6 py-24 border-l border-r border-b border-workbench-border">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-12 pb-6 border-b border-workbench-border/60">
    <div class="flex items-center gap-4">
      <div class="h-px w-8 bg-workbench-accent"></div>
      <span class="font-mono text-xs tracking-widest text-workbench-accent uppercase">
        // 04. Selected Projects
      </span>
    </div>
    <div class="font-mono text-xs text-workbench-muted flex items-center gap-2">
      <span>FEATURED ARCHIVES</span>
      <span class="text-workbench-accent font-bold">[ 03 ]</span>
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project) => (
      <a 
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col justify-between p-7 bg-workbench-surface/20 border border-workbench-border hover:border-workbench-accent/70 hover:bg-workbench-surface/40 transition-all duration-300 relative overflow-hidden"
      >
        <!-- Structural corner accent on hover -->
        <div class="absolute top-0 right-0 w-12 h-12 bg-linear-to-bl from-workbench-accent/20 to-transparent translate-x-full -translate-y-full group-hover:translate-x-0 group-hover:translate-y-0 transition-transform duration-300 pointer-events-none"></div>

        <div>
          <!-- Meta Top Bar -->
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="font-mono text-[11px] text-workbench-accent tracking-wider font-semibold">
              // {project.id}
            </span>
            <span class="font-mono text-[10px] uppercase px-2 py-0.5 bg-workbench-surface border border-workbench-border text-workbench-muted">
              {project.highlight}
            </span>
          </div>

          <h3 class="font-display font-bold text-2xl text-workbench-text mb-1 group-hover:text-workbench-accent transition-colors">
            {project.name}
          </h3>
          <p class="font-mono text-xs text-workbench-muted/80 mb-4">
            {project.tagline}
          </p>

          <p class="font-body text-sm text-workbench-muted leading-relaxed mb-6">
            {project.description}
          </p>
        </div>

        <!-- Tech Stack Badges with Authentic Icons -->
        <div class="pt-4 border-t border-workbench-border/60 mt-auto">
          <div class="font-mono text-[10px] uppercase tracking-wider text-workbench-muted/70 mb-2.5">
            Built With:
          </div>
          <div class="flex flex-wrap gap-2">
            {project.stack.map((tech) => (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-workbench-surface/90 border border-workbench-border font-mono text-[11px] text-workbench-text hover:border-workbench-accent/40 hover:text-white transition-colors">
                <TechIcon name={tech} class="w-3.5 h-3.5" />
                <span>{tech}</span>
              </span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
