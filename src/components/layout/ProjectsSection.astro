---
// src/components/layout/ProjectsSection.astro

const projects = [
  {
    name: "Circle",
    description: "Threads-like Social Media Platform featuring real-time posting, replies, likes, follow system, JWT authentication, and infinite scroll pagination with a 95+ Lighthouse score.",
    stack: ["React", "Express.js", "PostgreSQL", "Prisma ORM"],
    link: "#projects" // To be added
  },
  {
    name: "BookUs",
    description: "Bus Ticket Booking Platform. Built dual-interface for customers and admins with guest checkout and secure Midtrans payment integration via Supabase Edge Functions.",
    stack: ["React", "Supabase", "Midtrans API"],
    link: "#projects"
  },
  {
    name: "MieVerse",
    description: "Instant Noodle Catalog & Review Platform. Designed multi-criteria rating system, advanced search and filtering, achieving 98+ Lighthouse SEO score.",
    stack: ["Next.js", "PostgreSQL", "SSR"],
    link: "#projects"
  }
];
---

<section id="projects" class="w-full max-w-7xl mx-auto px-6 py-24 border-l border-r border-b border-workbench-border">
  <div class="flex items-center gap-4 mb-12">
    <div class="h-px w-8 bg-workbench-accent"></div>
    <span class="font-mono text-xs tracking-widest text-workbench-accent uppercase">
      // 04. Selected Projects
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project) => (
      <a 
        href={project.link}
        class="group flex flex-col justify-between p-8 bg-workbench-surface/30 border border-workbench-border hover:border-workbench-accent transition-colors duration-300 relative overflow-hidden"
      >
        <!-- Structural corner accent on hover -->
        <div class="absolute top-0 right-0 w-8 h-8 bg-workbench-accent/10 translate-x-full -translate-y-full group-hover:translate-x-0 group-hover:translate-y-0 transition-transform duration-300"></div>

        <div class="flex flex-col mb-8">
          <h3 class="font-display font-bold text-2xl text-workbench-text mb-4 group-hover:text-workbench-accent transition-colors">
            {project.name}
          </h3>
          <p class="font-body text-workbench-muted leading-relaxed">
            {project.description}
          </p>
        </div>

        <div class="flex flex-wrap gap-2 mt-auto">
          {project.stack.map(tech => (
            <span class="px-2 py-1 bg-workbench-surface border border-workbench-border font-mono text-[10px] uppercase tracking-wider text-workbench-text">
              {tech}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
