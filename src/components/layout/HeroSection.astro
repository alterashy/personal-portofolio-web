---
// src/components/layout/HeroSection.astro
import Button from '../ui/Button.astro';
---
<section class="relative w-full max-w-7xl mx-auto px-6 pt-16 pb-24 md:pt-32 md:pb-32 flex flex-col items-start justify-center border-l border-r border-workbench-border min-h-[80vh]">
  
  <!-- Structural Metadata Eyebrow -->
  <div class="flex items-center gap-4 mb-8">
    <div class="h-px w-12 bg-workbench-border"></div>
    <span class="font-mono text-sm tracking-widest text-workbench-muted uppercase">
      // altera.deck // Digital Workbench
    </span>
  </div>

  <!-- Main Thesis Headline -->
  <h1 class="text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-display font-extrabold text-workbench-text leading-tight mb-8">
    Architecting systems.<br />
    <span class="text-workbench-accent">Crafting experiences.</span>
  </h1>

  <!-- Body Content -->
  <p class="text-lg md:text-xl text-workbench-muted font-body max-w-2xl leading-relaxed mb-12">
    This is where ideas get built, tested, and shipped. I am Syifa Maulaya, a full stack engineer taking complex logic and turning it into fast, reliable software that works in the real world.
  </p>

  <!-- High-contrast Structural CTAs -->
  <div class="flex flex-col items-start gap-8">
    <!-- Primary Actions -->
    <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 w-full sm:w-auto">
      <Button href="/products" variant="primary" class="w-full sm:w-auto">
        Explore Products
      </Button>
      <Button href="/cv.pdf" variant="outline" class="w-full sm:w-auto" target="_blank" rel="noopener noreferrer">
        Download CV
      </Button>
    </div>
    
    <!-- Secondary Actions (Socials) -->
    <div class="flex flex-wrap items-center gap-3 border-t border-workbench-border pt-6 w-full sm:w-auto">
      <span class="font-mono text-xs uppercase tracking-widest text-workbench-muted mr-1 w-full sm:w-auto mb-2 sm:mb-0">// Connect:</span>
      
      <a 
        href="https://github.com/alterashy" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 px-3 py-1.5 bg-workbench-surface/40 hover:bg-workbench-surface border border-workbench-border hover:border-workbench-accent text-workbench-text hover:text-workbench-accent transition-colors duration-200 ease-out font-mono text-xs uppercase tracking-wider"
      >
        <svg class="w-3.5 h-3.5 fill-current text-workbench-muted group-hover:text-workbench-accent transition-colors duration-200 ease-out" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>

      <a 
        href="https://www.linkedin.com/in/syifamaulaya" 
        target="_blank" 
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 px-3 py-1.5 bg-workbench-surface/40 hover:bg-workbench-surface border border-workbench-border hover:border-workbench-accent text-workbench-text hover:text-workbench-accent transition-colors duration-200 ease-out font-mono text-xs uppercase tracking-wider"
      >
        <svg class="w-3.5 h-3.5 fill-current text-workbench-muted group-hover:text-workbench-accent transition-colors duration-200 ease-out" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.77v8.37H6.46v-8.37M7.85 6.4a1.61 1.61 0 1 0 0 3.22 1.61 1.61 0 0 0 0-3.22z" />
        </svg>
        <span>LinkedIn</span>
      </a>

      <a 
        href="mailto:maulayasyifa.mail@gmail.com"
        class="group inline-flex items-center gap-2 px-3 py-1.5 bg-workbench-surface/40 hover:bg-workbench-surface border border-workbench-border hover:border-workbench-accent text-workbench-text hover:text-workbench-accent transition-colors duration-200 ease-out font-mono text-xs uppercase tracking-wider"
      >
        <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2 text-workbench-muted group-hover:text-workbench-accent transition-colors duration-200 ease-out" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>Email</span>
      </a>
    </div>
  </div>
  
  <!-- Decorative Technical Elements -->
  <div class="absolute bottom-12 right-6 hidden md:flex items-end gap-2 text-workbench-muted opacity-50">
    <div class="w-2 h-2 bg-workbench-accent"></div>
    <span class="font-mono text-xs uppercase tracking-widest">SYS.RDY</span>
  </div>
  
  <!-- Subtle Grid Extension Overlay specific to Hero -->
  <div class="absolute inset-0 border-b border-workbench-border pointer-events-none -z-10"></div>
</section>
