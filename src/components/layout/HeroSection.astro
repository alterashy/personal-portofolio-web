---
// src/components/layout/HeroSection.astro
---
<section class="relative w-full max-w-7xl mx-auto px-6 pt-32 pb-24 md:pt-48 md:pb-32 flex flex-col items-start justify-center border-l border-r border-workbench-border min-h-[80vh]">
  
  <!-- Structural Metadata Eyebrow -->
  <div class="flex items-center gap-4 mb-8">
    <div class="h-px w-12 bg-workbench-border"></div>
    <span class="font-mono text-sm tracking-widest text-workbench-muted uppercase">
      // Workspace: Active
    </span>
  </div>

  <!-- Main Thesis Headline -->
  <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-extrabold text-workbench-text leading-tight mb-8">
    Architecting systems.<br />
    <span class="text-workbench-accent">Crafting experiences.</span>
  </h1>

  <!-- Body Content -->
  <p class="text-lg md:text-xl text-workbench-muted font-body max-w-2xl leading-relaxed mb-12">
    I'm Syifa Maulaya, a Full-Stack Developer specializing in robust backend architectures and dynamic frontend interfaces for any industry. Welcome to the workbench.
  </p>

  <!-- High-contrast Structural CTAs (No Glow) -->
  <div class="flex flex-col sm:flex-row items-center gap-6">
    <a 
      href="/products" 
      class="w-full sm:w-auto px-8 py-4 bg-workbench-accent text-white font-display font-bold text-lg tracking-wide uppercase hover:bg-orange-600 transition-colors duration-200 border border-workbench-accent"
    >
      Explore Products
    </a>
    <a 
      href="/about" 
      class="w-full sm:w-auto px-8 py-4 bg-transparent text-workbench-text font-display font-bold text-lg tracking-wide uppercase border border-workbench-border hover:bg-workbench-surface transition-colors duration-200"
    >
      View Source
    </a>
  </div>
  
  <!-- Decorative Technical Elements -->
  <div class="absolute bottom-12 right-6 hidden md:flex items-end gap-2 text-workbench-muted opacity-50">
    <div class="w-2 h-2 bg-workbench-accent"></div>
    <span class="font-mono text-xs uppercase tracking-widest">SYS.RDY</span>
  </div>
  
  <!-- Subtle Grid Extension Overlay specific to Hero -->
  <div class="absolute inset-0 border-b border-workbench-border pointer-events-none -z-10"></div>
</section>
