---
// src/components/ui/TechIcon.astro
import { getTechIconSvg } from '../../utils/techIcons';

interface Props {
  name: string;
  variant?: 'light' | 'dark' | 'grayscale';
  class?: string;
  size?: number | string;
}

const { name, variant = 'light', class: className = 'w-5 h-5', size } = Astro.props;
const svgContent = getTechIconSvg(name, variant);
---

{svgContent ? (
  <span 
    class:list={["inline-flex items-center justify-center shrink-0 [&>svg]:w-full [&>svg]:h-full [&>svg]:block", className]}
    style={size ? { width: typeof size === 'number' ? `${size}px` : size, height: typeof size === 'number' ? `${size}px` : size } : undefined}
    set:html={svgContent}
    aria-hidden="true"
  />
) : (
  <span class:list={["inline-flex items-center justify-center shrink-0 text-workbench-accent font-mono text-xs", className]}>
    ›
  </span>
)}
