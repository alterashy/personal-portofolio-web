---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "A personal portfolio and product landing page.",
  image = "/og-image.png"
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/altera-logo.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Outfit:wght@400;500;700;800&display=swap" rel="stylesheet">

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Pre-hydration Theme Initializer (Anti-FOUC) -->
    <script is:inline>
      (function() {
        try {
          const saved = localStorage.getItem('altera_deck_theme') || localStorage.getItem('altera_deck_mode');
          if (saved) {
            const normalized = saved === 'acid' ? 'emerald' : saved === 'forge' ? 'orange' : saved;
            document.documentElement.setAttribute('data-deck', normalized);
          } else {
            document.documentElement.setAttribute('data-deck', 'cyan');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="relative min-h-screen">
    <!-- Signature Background Element -->
    <div class="grid-overlay bg-structural-grid"></div>
    
    <div class="relative z-10 flex flex-col min-h-screen pt-16">
      <Header />
      <slot />
      <Footer />
    </div>
  </body>
</html>
