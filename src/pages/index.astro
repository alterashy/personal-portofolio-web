---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/layout/HeroSection.astro';
import AboutSection from '../components/layout/AboutSection.astro';
import ExperienceSection from '../components/layout/ExperienceSection.astro';
import SkillsSection from '../components/layout/SkillsSection.astro';
import ProjectsSection from '../components/layout/ProjectsSection.astro';
import ContactSection from '../components/layout/ContactSection.astro';
---

<BaseLayout 
  title="Altera Space | Syifa Maulaya | Full Stack Engineer" 
  description="Portfolio and workspace of Syifa Maulaya, a full stack engineer building web systems, backend services, and tools."
>
  <main class="w-full min-h-screen">
    <!-- Hero Section -->
    <HeroSection />
    
    <!-- About Section -->
    <AboutSection />
    
    <!-- Experience Section -->
    <ExperienceSection />
    
    <!-- Skills Section -->
    <SkillsSection />
    
    <!-- Projects Section -->
    <ProjectsSection />
    
    <!-- Contact Section -->
    <ContactSection />
  </main>
</BaseLayout>
