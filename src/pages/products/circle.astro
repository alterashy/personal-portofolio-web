---
import ProductLayout from '../../layouts/ProductLayout.astro';
import CircleHero from '../../products/circle/components/CircleHero.astro';
import CircleFeatures from '../../products/circle/components/CircleFeatures.astro';
import CirclePricing from '../../products/circle/components/CirclePricing.astro';
import { circleData } from '../../products/circle/data';
---

<ProductLayout 
  title={`${circleData.name} - ${circleData.tagline}`}
  description={circleData.description}
>
  <main class="w-full">
    <CircleHero />
    <CircleFeatures />
    <CirclePricing />
  </main>
</ProductLayout>
