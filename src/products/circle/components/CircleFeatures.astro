---
// src/products/circle/components/CircleFeatures.astro
import { circleData } from '../data';
---

<section id="features" class="relative w-full max-w-7xl mx-auto px-6 py-32 border-l border-r border-t border-workbench-border bg-workbench-bg">
  
  <div class="mb-20 flex flex-col items-center text-center">
    <div class="flex items-center gap-4 mb-6">
      <div class="h-px w-8 bg-workbench-accent"></div>
      <span class="font-mono text-xs tracking-widest text-workbench-accent uppercase">
        // Capabilities
      </span>
      <div class="h-px w-8 bg-workbench-accent"></div>
    </div>

    <h2 class="text-4xl md:text-5xl font-display font-bold text-workbench-text mb-6">
      Built for speed and scale.
    </h2>
    <p class="text-workbench-muted font-body text-lg max-w-2xl">
      No fluff, just the engineering primitives your team needs to move faster without breaking things.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {circleData.features.map((feature, idx) => (
      <div class="group flex flex-col items-start p-8 border border-workbench-border bg-workbench-surface/50 hover:bg-workbench-surface transition-all duration-300 relative overflow-hidden">
        
        <!-- Index Number -->
        <span class="absolute top-4 right-4 font-mono text-xs text-workbench-border group-hover:text-workbench-muted transition-colors">
          {String(idx + 1).padStart(2, '0')}
        </span>

        <div class="w-12 h-12 flex items-center justify-center border border-workbench-border bg-workbench-bg text-workbench-accent mb-8 font-mono font-bold text-xl group-hover:-translate-y-1 group-hover:border-workbench-accent transition-all duration-300">
          //
        </div>
        
        <h3 class="text-2xl font-display font-bold text-workbench-text mb-4">{feature.title}</h3>
        <p class="text-workbench-muted font-body leading-relaxed">{feature.description}</p>
        
        <!-- Bottom Accent Line -->
        <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-workbench-accent group-hover:w-full transition-all duration-500 ease-out"></div>
      </div>
    ))}
  </div>
</section>
