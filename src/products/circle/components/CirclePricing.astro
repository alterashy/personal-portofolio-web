---
// src/products/circle/components/CirclePricing.astro
import { circleData } from '../data';
import Button from '../../../components/ui/Button.astro';
---

<section id="pricing" class="relative w-full max-w-7xl mx-auto px-6 py-32 border-l border-r border-t border-workbench-border bg-workbench-bg">
  <div class="mb-20 flex flex-col items-center text-center">
    <div class="flex items-center gap-4 mb-6">
      <div class="h-px w-8 bg-workbench-accent"></div>
      <span class="font-mono text-xs tracking-widest text-workbench-accent uppercase">
        // Deployment Plans
      </span>
      <div class="h-px w-8 bg-workbench-accent"></div>
    </div>

    <h2 class="text-4xl md:text-5xl font-display font-bold text-workbench-text mb-6">
      Transparent Pricing.
    </h2>
    <p class="text-workbench-muted font-body text-lg max-w-2xl">
      Start for free, scale when you need the horsepower.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
    {circleData.pricing.map((tier) => {
      const isPro = tier.tier.toLowerCase() === 'pro';
      return (
        <div class={`flex flex-col p-8 border ${isPro ? 'border-workbench-accent bg-workbench-surface/10 shadow-[0_0_30px_rgba(240,86,46,0.05)]' : 'border-workbench-border bg-workbench-bg'} relative`}>
          
          {isPro && (
            <div class="absolute top-0 right-0 px-3 py-1 bg-workbench-accent text-white font-mono text-[10px] uppercase tracking-widest border-l border-b border-workbench-accent">
              Recommended
            </div>
          )}

          <h3 class="text-2xl font-display font-bold text-workbench-text mb-2">{tier.tier}</h3>
          <div class="flex items-end gap-2 mb-8 border-b border-workbench-border pb-8">
            <span class="text-5xl font-display font-extrabold text-workbench-text">{tier.price}</span>
            {tier.price !== "$0" && <span class="text-workbench-muted font-mono mb-2">/ seat</span>}
          </div>

          <ul class="flex flex-col gap-4 mb-12 flex-grow">
            {tier.features.map(feat => (
              <li class="flex items-start gap-3">
                <span class="text-workbench-accent font-mono mt-1">&rarr;</span>
                <span class="text-workbench-muted font-body">{feat}</span>
              </li>
            ))}
          </ul>

          <Button href="#signup" variant={isPro ? 'primary' : 'outline'} class="w-full">
            {isPro ? 'Upgrade to Pro' : 'Deploy Starter'}
          </Button>
        </div>
      );
    })}
  </div>
</section>
